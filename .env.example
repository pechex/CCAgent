# Timezone configuration
TZ=America/Argentina/Buenos_Aires
STEALTH_TIMEZONE=America/Argentina/Buenos_Aires
STEALTH_SEED=42

# Automation tasks configuration (all default to true if omitted)
ENABLE_CHECKIN=true
ENABLE_RAFFLE=true
ENABLE_DOWNLOADS=true
DOWNLOADS_COUNT=10
ENABLE_IMAGE_COMMENTS=true
IMAGE_COMMENTS_COUNT=5
ENABLE_TEXT_COMMENT=true
ENABLE_BOOST=true
HEADLESS=true

# Optional overrides:
# CREALITY_USER_ID=xxxxxx
# CREALITY_BOOST_URL=https://www.crealitycloud.com/es/user/xxxxxx/boost
